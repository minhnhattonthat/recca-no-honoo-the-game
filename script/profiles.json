  "table": 4627132,
  "name_jp": "最澄",
  "jp": [
   "（さいちょう）",
   "魔導具・式紙を使い紙",
   "に命を吹き込んで戦う",
   "格闘集団・空の一員。",
   "持病のため長時間戦う",
   "ことができない。",
   "",
   "見た目は凄くきゃしゃ",
   "で女の子に見間違うほ",
   "どだがれっきとした",
   "男性である。"
  ],
  "name": "",
  "en": "",
  "status": ""
 },
 {
