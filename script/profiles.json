  "name_jp": "死愚魔",
  "jp": [
   "（しぐま）",
   "キリトの魔導具・涅槃",
   "によって操られる謎の",
   "生物。",
   "",
   "巨大な身体から放たれ",
   "る無数の魔弾を武器と",
   "し、その威力はＳＯＤ",
   "ＯＭの建物を楽に破壊",
   "できるほど強力。"
  ],
  "name": "",
  "en": "",
  "status": ""
 },
 {
