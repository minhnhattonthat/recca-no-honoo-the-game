[
 {
  "id": "prof_00",
  "table": 4627028,
  "name_jp": "花菱烈火",
  "jp": [
   "（はなびしれっか）",
   "姓は花菱、名は烈火。",
   "花火職人の義父をもつ",
   "高校生。",
   "",
   "四百年前、火影忍軍党",
   "首・桜花と正妻・陽炎",
   "の間に生まれた炎術士",
   "の能力をもつ火影の子",
   "孫。",
   "",
   "信長の猛威から逃れる",
   "ため陽炎の秘術・時空",
   "流離によって現代へ送",
   "られ今に至る。",
   "",
   "火影党首の血を引く彼",
   "は炎術士の能力を持ち",
   "腕の中に八つの火竜を",
   "従えている。",
   "",
   "あることから、高校で",
   "同級生の佐古下柳を姫",
   "と呼び、自ら姫の忍び",
   "となって命を賭して守",
   "ることを誓う。"
  ],
  "name": "",
  "en": "",
  "status": ""
 },
 {
  "id": "prof_01",
  "table": 4627036,
  "name_jp": "石島土門",
  "jp": [
   "（いしじまどもん）",
   "烈火と同じ高校に通う",
   "ケンカ仲間。",
   "",
   "力任せの戦い方をする",
   "パワーファイター。",
   "とっさの行動でピンチ",
   "を切り抜ける強運の",
   "持ち主。",
   "だが、すべては本能に",
   "よるところが土門の",
   "強さかもしれない。",
   "",
   "火影一の足手まといと",
   "思われていたが、多く",
   "の戦いを通じて大きな",
   "成長ぶりを見せる。"
  ],
  "name": "",
  "en": "",
  "status": ""
 },
 {
  "id": "prof_02",
  "table": 4627044,
  "name_jp": "霧沢風子",
  "jp": [
   "（きりさわふうこ）",
   "烈火と同じ高校に通う",
   "幼なじみの女子高生。",
   "格闘好きで烈火や土門",
   "といつも戦っている。",
   "",
   "陽炎に魔導具・風神を",
   "もらい、後の戦いでは",
   "鬼の爪を組合せて戦う",
   "器用な一面を見せる。",
   "負けず嫌いで荒っぽい",
   "が面倒見のいい一面も",
   "ある。",
   "",
   "得意技は風の爪。"
  ],
  "name": "",
  "en": "",
  "status": ""
 },
 {
  "id": "prof_03",
  "table": 4627052,
  "name_jp": "水鏡凍季也",
  "jp": [
   "（みかがみときや）",
   "烈火らと同じ学校に",
   "通う高校生。",
   "幼少の頃、姉を殺され",
   "復讐に生きるためか",
   "非常に冷徹に見える。",
   "",
   "姉の形見である魔導具",
   "閻水を武器に復讐の戦",
   "いを続けるが、烈火た",
   "ちとの戦いの中、復讐",
   "だけに生きる人生の空",
   "しさを悟り、少しずつ",
   "変化が現れる。"
  ],
  "name": "",
  "en": "",
  "status": ""
 },
 {
  "id": "prof_04",
  "table": 4627060,
  "name_jp": "小金井薫",
  "jp": [
   "（こがねいかおる）",
   "紅麗率いる暗殺集団・",
   "麗の元一員。",
   "",
   "紅麗の裏切りの真意を",
   "確かめるため、火影の",
   "一員となり烈火たちと",
   "行動を共にする。",
   "",
   "五つの型を持つ魔導具",
   "鋼金暗器を使う。その",
   "戦闘能力は、他の仲間",
   "にも引けをとらず幻の",
   "六の型を完成させ更に",
   "優れた魔導具の使い手",
   "となる。"
  ],
  "name": "",
  "en": "",
  "status": ""
 },
 {
  "id": "prof_05",
  "table": 4627068,
  "name_jp": "紅麗",
  "jp": [
   "（くれい）",
   "四百年前、火影忍軍党",
   "首・桜花と側室・麗奈",
   "の間に生まれた炎術士",
   "の能力をもつ火影の子",
   "孫。烈火の異母兄弟。",
   "",
   "烈火が陽炎の秘術・時",
   "空流離で送られた際に",
   "まぎれこみ、現代に",
   "生き延びている。",
   "",
   "側室の子であった彼は",
   "正室・陽炎に烈火が生",
   "まれたことから周りの",
   "火影忍軍たちに悪魔の",
   "子として虐げられ、そ",
   "れが原因で烈火を恨み",
   "つづけている。",
   "",
   "また、森光蘭に、育て",
   "の母・月乃を人質とし",
   "て捕られているため、",
   "近衛部隊・麗を従える",
   "長として仕えている。",
   "",
   "森光蘭の手によって殺",
   "された最愛の人・紅を",
   "自らの炎の戦士として",
   "取り込んでおり、その",
   "力は烈火の炎をも圧倒",
   "する。"
  ],
  "name": "",
  "en": "",
  "status": ""
 },
 {
  "id": "prof_06",
  "table": 4627076,
  "name_jp": "煉華",
  "jp": [
   "（れんげ）",
   "森光蘭によって生み出",
   "された紅麗と紅の遺伝",
   "子をもつクローン。",
   "烈火、紅麗と同じく炎",
   "を操ることができる。",
   "",
   "森光蘭の忠実なるしも",
   "べ。"
  ],
  "name": "",
  "en": "",
  "status": ""
 },
 {
  "id": "prof_07",
  "table": 4627084,
  "name_jp": "蛭湖",
  "jp": [
   "（ひるこ）",
   "裏麗・死四天の一人。",
   "通称、不死身の蛭湖。",
   "",
   "生体魔導具・血種と融",
   "合して、生成される自",
   "らの血液・魔血を意の",
   "ままに操り戦う。",
   "",
   "地獄のような戦闘教育",
   "を受け、裏麗・死四天",
   "の座を与えられた彼は",
   "戦う使命感のみで戦闘",
   "を行う。"
  ],
  "name": "",
  "en": "",
  "status": ""
 },
 {
  "id": "prof_08",
  "table": 4627092,
  "name_jp": "門都",
  "jp": [
   "（かどつ）",
   "紅麗率いる暗殺集団・",
   "麗の内部用暗殺部隊・",
   "裏麗の一員。",
   "",
   "紅麗が追放にあってか",
   "らは森光蘭の部隊と",
   "して烈火たちを狙う。",
   "",
   "体がとてつもなく大き",
   "くパワーも人間離れし",
   "ている。",
   "",
   "魔導具・無名は他の物",
   "と異なり手甲の門構と",
   "組み合わせることで、",
   "様々な攻撃を生み出せ",
   "る。"
  ],
  "name": "",
  "en": "",
  "status": ""
 },
 {
  "id": "prof_09",
  "table": 4627100,
  "name_jp": "森光蘭",
  "jp": [
   "（もりこうらん）",
   "火影忍軍の魔導具は虚",
   "空と海魔の２人により",
   "それぞれ、生かす為の",
   "魔導具、殺すだけの魔",
   "導具として造られた。",
   "",
   "その海魔が最後に造っ",
   "た火影忍軍最強の魔導",
   "具が「天堂地獄」であ",
   "り海魔自身の魂が封じ",
   "込められている。",
   "",
   "危険視された天堂地獄",
   "は長い間封印されてい",
   "たが、あらゆる欲望を",
   "満たそうとする森光蘭",
   "の手によって再び目覚",
   "め、森光蘭自身と融合",
   "し強大な力を持つ存在",
   "となった。",
   "",
   "天堂地獄と融合した森",
   "光蘭は完全体となる為",
   "に治癒の少女・佐古下",
   "柳を取り込むべく彼女",
   "を誘拐し、ＳＯＤＯＭ",
   "奥地で融合の準備をお",
   "こなっている。"
  ],
  "name": "",
  "en": "",
  "status": ""
 },
 {
  "id": "prof_10",
  "table": 4627108,
  "name_jp": "火車丸",
  "jp": [
   "（かしゃまる）",
   "紅麗率いる暗殺集団・",
   "麗の内部用暗殺部隊・",
   "裏麗の一員。",
   "",
   "忍法・鏡地獄で対戦相",
   "手の技を真似るのが得",
   "意。魔導具・偽火を使",
   "うことで烈火の八竜で",
   "すら真似てしまうが、",
   "未知の相手の技は真似",
   "することができない。"
  ],
  "name": "",
  "en": "",
  "status": ""
 },
 {
  "id": "prof_11",
  "table": 4627116,
  "name_jp": "木蓮",
  "jp": [
   "（もくれん）",
   "紅麗率いる暗殺集団・",
   "麗の一員。通称、仁無",
   "き男、木霊の木蓮。",
   "",
   "木火土金水の五行に属",
   "する木の魔導具・木霊",
   "を使い、体内に飼う木",
   "の根を武器とする植物",
   "使い。",
   "",
   "利己的で残虐。烈火に",
   "対し異様なまでの執着",
   "を見せる。"
  ],
  "name": "",
  "en": "",
  "status": ""
 },
 {
  "id": "prof_12",
